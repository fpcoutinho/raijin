  "query": "\n        SELECT finding_category, report_section, caption\n        FROM report_images\n        WHERE report_id = $1\n          AND upload_status = 'uploaded'\n          AND (finding_category IS NOT NULL OR report_section IS NOT NULL)\n          AND ($2::uuid[] IS NULL OR id = ANY($2))\n        ORDER BY position\n        ",
