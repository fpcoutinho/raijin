# auth
JWT_SECRET=
GOOGLE_CLIENT_ID=
# Autentica POST /tasks/cleanup-sessions (EventBridge Scheduler). Mínimo 32 bytes.
TASK_TOKEN=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# db
DATABASE_URL=postgres://raijin:raijin@localhost:5432/raijin

# storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=raijin
STORAGE_ACCESS_KEY_ID=raijin
STORAGE_SECRET_ACCESS_KEY=raijin123
STORAGE_REGION=auto

# proxy LLM
LLM_CHAIN=groq:llama-3.3-70b-versatile,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MAX_OUTPUT_TOKENS=6144

# feature flags
FF_NBR_VALIDATION_ENABLED=true
